<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#E7EBFC">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#3445A5" android:textSize="18sp" android:textStyle="bold" android:gravity="right"/>
<ImageView android:id="@+id/widget_calendar" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:scaleType="fitCenter" android:contentDescription="تقویم شمسی"/>
<TextView android:id="@+id/widget_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#222222" android:textSize="13sp" android:gravity="right" android:maxLines="3"/>
<TextView android:id="@+id/note_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="35dp" android:gravity="center_vertical|right" android:background="#FFFFFF" android:textColor="#202C65" android:padding="6dp" android:visibility="gone"/>
<TextView android:id="@+id/note_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="35dp" android:gravity="center_vertical|right" android:background="#FFFFFF" android:textColor="#202C65" android:padding="6dp" android:visibility="gone"/>
<TextView android:id="@+id/note_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="35dp" android:gravity="center_vertical|right" android:background="#FFFFFF" android:textColor="#202C65" android:padding="6dp" android:visibility="gone"/>
</LinearLayout>